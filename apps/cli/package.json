{
  "name": "openmimir",
  "version": "0.2.0",
  "description": "One voice-first chat that controls all your coding agents. Hands-free, full duplex.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://openmimir.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openmimir/openmimir.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "voice",
    "coding-agent",
    "opencode",
    "foreman",
    "hands-free",
    "gpt-live"
  ],
  "bin": {
    "mimir": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "start": "bun run src/index.ts"
  },
  "devDependencies": {
    "@openmimir/adapters": "workspace:*",
    "@openmimir/core": "workspace:*",
    "@openmimir/protocol": "workspace:*",
    "@openmimir/voice": "workspace:*"
  }
}
